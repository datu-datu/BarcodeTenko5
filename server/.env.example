# サーバ設定のサンプル。コピーして .env として使用してください。

# 待ち受けポート
PORT=8080

# SQLite データベースのパス
DB_PATH=./data/tenko.db

# クライアント(Windowsソフト)が送信時に付与する共有トークン。
# 空にするとクライアントAPIは認証なしになります(非推奨)。
CLIENT_TOKEN=change-me-shared-token

# 管理画面のログインパスワード。空にすると管理APIは無効になります。
ADMIN_PASSWORD=change-me-admin-password

# 管理セッションCookieの署名鍵。長いランダム文字列を設定してください。
# 未設定(空)の場合、管理画面は無効になります。
SESSION_SECRET=

# 状況ダッシュボードの閲覧トークン。
# 設定するとダッシュボードに ?token=xxx が必要になります。空なら誰でも閲覧可。
DASHBOARD_TOKEN=

# Power Automate の Teams Webhook の URL。
# (Power Automate の「Teams Webhook 要求を受信したとき」トリガーの URL を貼り付け)
# 空なら転送しません。無料の Teams Webhook を使うことで追加ライセンスなしで運用できます。
WEBHOOK_URL=

# Webhook に付与する共有シークレット (任意, X-Webhook-Secret ヘッダ)。
WEBHOOK_SECRET=

# Webhook の自動送信設定。
# 未送信の受付を INTERVAL_MS ごとに 1 回の Webhook にまとめて送信します (既定: 300000ms = 5分)。
# BATCH_SIZE は手動送信 (「今すぐ送信」/選択送信) で 1 回に送る件数です。
WEBHOOK_INTERVAL_MS=300000
WEBHOOK_BATCH_SIZE=10
