<Window x:Class="BarcodeTenko.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="学生点呼" Height="580" Width="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <DockPanel Grid.Row="0" Margin="12,10,12,6">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="SettingsButton" Content="点呼場所" Style="{StaticResource ModernButton}" 
                        Margin="0,0,6,0" Click="Settings_Click"/>
                <Button x:Name="OpenBinFolderButton" Content="提出データフォルダー" Style="{StaticResource ModernButton}" 
                        Click="OpenBinFolder_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="場所:" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="LocationText" VerticalAlignment="Center" FontSize="14"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </DockPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="12,4,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Guide Text (Row 0, Column 0) -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="学籍番号またはバーコードをスキャン" 
                       FontSize="12" VerticalAlignment="Bottom" Margin="0,0,12,6" 
                       Foreground="{StaticResource TextSecondaryBrush}"/>

            <!-- Right Panel: Search Bar (Row 0, Column 1) -->
            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="検索:" VerticalAlignment="Center" FontSize="11" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                    <Grid Width="160">
                        <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}"
                                 FontSize="11" Height="24" VerticalContentAlignment="Center"
                                 InputMethod.IsInputMethodEnabled="False"
                                 Padding="4,1,20,1" TextChanged="SearchBox_TextChanged"/>
                        <Button x:Name="ClearSearchButton" Content="✕" Click="ClearSearch_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="18" Height="18" Margin="0,0,2,0"
                                BorderThickness="0" Background="Transparent" Foreground="#888888"
                                FontSize="10" ToolTip="クリア" Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
            </DockPanel>

            <!-- Left Panel: Controls (Row 1, Column 0) -->
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top: Inputs, Status -->
                <StackPanel Grid.Row="0">
                    <TextBox x:Name="InputBox" Style="{StaticResource ModernTextBox}" 
                            FontSize="16" Height="30" VerticalContentAlignment="Center"
                            InputMethod.IsInputMethodEnabled="False"
                            KeyDown="InputBox_KeyDown"/>
                    
                    <Button x:Name="SubmitButton" Content="決定" Click="Submit_Click"
                            Style="{StaticResource ModernButton}" Height="28" Margin="0,6,0,0"/>

                    <!-- 直前の受付結果（枠なし1行） -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0" Height="24">
                        <TextBlock x:Name="LastScanStatusText" Text="受付中" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="LastScanNumberText" Text="" FontSize="16" FontWeight="Bold"
                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Row 1: Spacer -->

                <!-- Bottom: Total Count & Action Buttons (Row 2) -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="累計" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Border Background="#F0F0F0" Padding="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="TotalCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text=" 件" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="CompleteButton" Content="点呼完了" Click="Complete_Click"
                            Style="{StaticResource ModernButton}" Height="30"/>

                    <Separator Margin="0,10"/>

                    <Button x:Name="DeleteAllButton" Content="全履歴を削除" Click="DeleteAll_Click"
                            Style="{StaticResource ModernButton}" Height="26" FontSize="11"
                            Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Right Panel: DataGrid (Row 1, Column 1) -->
            <DataGrid x:Name="ScanGrid" Grid.Row="1" Grid.Column="1" AutoGenerateColumns="False" 
                    IsReadOnly="True" CanUserAddRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecentlyAdded}" Value="True">
                                <Setter Property="Background" Value="#E1F5FE"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="時刻" Binding="{Binding TimeText}" Width="100"/>
                    <DataGridTextColumn Header="点呼場所" Binding="{Binding LocationName}" Width="110"/>
                    <DataGridTextColumn Header="学籍番号" Binding="{Binding StudentNumberText}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="操作" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="取り消し" Click="Cancel_Click" Tag="{Binding}"
                                        Style="{StaticResource ModernButton}"
                                        Padding="4,0" FontSize="10" MinWidth="40" MinHeight="20"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="{StaticResource BackgroundBrush}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0" Margin="10,0,0,0">
                <TextBlock x:Name="ClockText" Text="--:--:--" FontSize="11" FontFamily="Consolas"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" Margin="0,0,10,0">
                <TextBlock x:Name="SyncText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
