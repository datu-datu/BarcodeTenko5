<Window x:Class="BarcodeTenko.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="くぬぎだ祭点呼ビューア" Height="580" Width="880"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <DockPanel Grid.Row="0" Margin="14,10,14,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="CsvButton" Content="名簿CSV読込" Style="{StaticResource ModernButton}"
                        Margin="0,0,6,0" Click="LoadCsv_Click"/>
                <Button x:Name="OpenBinButton" Content="binを開く" Style="{StaticResource ModernButton}"
                        Margin="0,0,6,0" Click="OpenBin_Click"/>
                <Button x:Name="LoginButton" Content="ログイン" Style="{StaticResource ModernButton}"
                        Margin="0,0,6,0" Click="Login_Click"/>
                <Button x:Name="RefreshButton" Content="更新" Style="{StaticResource ModernButton}"
                        Click="Refresh_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="ServerModeRadio" Content="サーバー" IsChecked="True"
                             VerticalAlignment="Center" Margin="0,0,8,0"
                             Checked="ServerMode_Checked"/>
                <RadioButton x:Name="FileModeRadio" Content="ファイル"
                             VerticalAlignment="Center" Margin="0,0,14,0"
                             Checked="FileMode_Checked"/>

                <TextBlock Text="表示元:" Margin="0,0,6,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="SourceText" Text="—" VerticalAlignment="Center" FontSize="14"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </DockPanel>

        <!-- Main Content Area: Left & Right Panels on Gray Background -->
        <Grid Grid.Row="1" Margin="14,0,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel (summary card) -->
            <Border Grid.Column="0" Background="#F5F5F5"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="点呼完了率" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Border Background="#F5F5F5" Padding="8" BorderThickness="1"
                            BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="RateText" Text="—" FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="SessionText" Text="セッション未設定" FontSize="11" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="点呼済み / 対象者数" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Border Background="#F5F5F5" Padding="8" BorderThickness="1"
                            BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,12">
                        <TextBlock x:Name="TotalText" Text="0 / 0" FontSize="18" FontWeight="Bold"
                                   FontFamily="Consolas" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>

                    <TextBlock Text="名簿 (CSV)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Border Background="#F5F5F5" Padding="8" BorderThickness="1"
                            BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="RosterFileText" Text="未読込" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="RosterCountText" Text="" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="最終更新" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="LastUpdatedText" Text="—" FontSize="11" FontFamily="Consolas"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Right Panel: Search & DataGrid -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Bar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock x:Name="ResultCountText" Text="" VerticalAlignment="Center" FontSize="11"
                               Margin="0,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                               DockPanel.Dock="Left"/>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="検索:" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                        <Grid Width="180">
                            <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}"
                                     FontSize="11" Height="24" VerticalContentAlignment="Center"
                                     InputMethod.IsInputMethodEnabled="False"
                                     Padding="4,1,20,1" TextChanged="SearchBox_TextChanged"/>
                            <Button x:Name="ClearSearchButton" Content="✕" Click="ClearSearch_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="18" Height="18" Margin="0,0,2,0"
                                    BorderThickness="0" Background="Transparent" Foreground="#888888"
                                    FontSize="10" ToolTip="クリア" Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </DockPanel>

                <!-- DataGrid -->
                <DataGrid x:Name="ScanGrid" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecentlyAdded}" Value="True">
                                    <Setter Property="Background" Value="#E1F5FE"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="時刻" Binding="{Binding TimeText}" Width="110"/>
                        <DataGridTextColumn Header="点呼場所" Binding="{Binding LocationName}" Width="110"/>
                        <DataGridTextColumn Header="学籍番号" Binding="{Binding StudentNumberText}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="クラス" Binding="{Binding ClassName}" Width="110"/>
                        <DataGridTextColumn Header="氏名" Binding="{Binding Name}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="{StaticResource BackgroundBrush}"
                   BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0" Margin="14,0,0,0">
                <TextBlock x:Name="ClockText" Text="--:--:--" FontSize="11" FontFamily="Consolas"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" Margin="0,0,14,0">
                <TextBlock x:Name="StatusText" Text="" FontSize="11" TextWrapping="NoWrap"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
